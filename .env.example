# PostgreSQL
POSTGRES_USER=invoiceiq
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=invoiceiq

DATABASE_URL="postgresql://invoiceiq:your_secure_password_here@localhost:5432/invoiceiq?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# On Render, REDIS_URL is provided by the Key Value service.
# REDIS_URL=redis://localhost:6379

# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
EXTRACTION_SERVICE_URL=http://localhost:8000
STORAGE_DIR=./storage

